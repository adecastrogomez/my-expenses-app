PORT=3000
# Orígenes permitidos por CORS, separados por comas
CORS_ORIGIN=http://localhost:5173

# Supabase > Project Settings > Data API > Project URL
SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
# Solo si tu proyecto aún usa el secreto HS256 legacy (Project Settings > JWT). Si lo dejas vacío se usan las claves públicas JWKS.
SUPABASE_JWT_SECRET=

# Supabase > Connect > Connection string (Session pooler, puerto 5432)
DATABASE_URL=postgresql://postgres.TU_PROJECT_REF:TU_PASSWORD@aws-0-XX.pooler.supabase.com:5432/postgres
